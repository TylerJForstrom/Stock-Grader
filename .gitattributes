# M5 universe inputs are immutable byte-addressed artifacts. Never translate
# their line endings: the registered spec uses CRLF and memberships use LF.
config/universe_spec.json -text whitespace=cr-at-eol
config/universe_liq*.txt -text

# Frozen score panels are immutable byte-addressed parts whose sha256s are
# recorded in sibling manifest.json catalogs. Parquet is binary; make that
# explicit so no platform ever line-ending-translates a hash-pinned part.
*.parquet -text

# The cross-repository cost-model pin. Stock-Vault carries a byte-identical
# copy; keep both at LF so the two files compare equal on any platform. The
# hash in costs.py is taken over canonical JSON, not raw bytes, so a stray CRLF
# cannot fail the pin — this keeps the bytes tidy, it is not the guarantee.
src/stock_grader/config/cost_golden_vectors.json text eol=lf

# Dated calibration artifacts are hash-pinned: each trio's .sha256 file
# records the sha256 of the .json and .md BYTES as written. A platform that
# translates their line endings changes those bytes and breaks the pin, which
# is exactly what a Windows checkout did before this line existed. Same rule
# as the universe inputs above, for the same reason.
docs/calibration/*.json -text
docs/calibration/*.md -text
docs/calibration/*.sha256 -text
